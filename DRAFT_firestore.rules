rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Helper Primitives
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'hasimsk12sk@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/website_admins/$(request.auth.uid)));
    }

    // ---------------------------------------------------------
    // Validation Blueprints
    // ---------------------------------------------------------
    function isValidWebsiteApp(data) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'iconUrl', 'screenshots', 'version', 'size',
          'developerName', 'category', 'shortDescription', 'fullDescription',
          'features', 'whatsNew', 'uploadDate', 'updatedDate', 'status',
          'isFeatured', 'isTrending', 'isPopular', 'downloadCount', 'viewCount',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'slug', 'iconUrl', 'screenshots', 'version', 'size',
          'developerName', 'category', 'shortDescription', 'fullDescription',
          'features', 'whatsNew', 'uploadDate', 'updatedDate', 'status',
          'isFeatured', 'isTrending', 'isPopular', 'downloadCount', 'viewCount',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 140 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.iconUrl is string && data.iconUrl.size() >= 1 && data.iconUrl.size() <= 350000
        && data.screenshots is list && data.screenshots.size() <= 8
        && (data.screenshots.size() == 0 || (data.screenshots[0] is string && data.screenshots[0].size() <= 350000))
        && data.version is string && data.version.size() >= 1 && data.version.size() <= 40
        && data.size is string && data.size.size() >= 1 && data.size.size() <= 40
        && data.developerName is string && data.developerName.size() >= 1 && data.developerName.size() <= 100
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.shortDescription is string && data.shortDescription.size() >= 1 && data.shortDescription.size() <= 220
        && data.fullDescription is string && data.fullDescription.size() >= 1 && data.fullDescription.size() <= 6000
        && data.features is list && data.features.size() <= 20
        && (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 160))
        && data.whatsNew is string && data.whatsNew.size() <= 2500
        && data.uploadDate is string && data.uploadDate.size() >= 1 && data.uploadDate.size() <= 30
        && data.updatedDate is string && data.updatedDate.size() >= 1 && data.updatedDate.size() <= 30
        && data.status in ['published', 'unpublished', 'draft']
        && data.isFeatured is bool
        && data.isTrending is bool
        && data.isPopular is bool
        && data.downloadCount is int && data.downloadCount >= 0
        && data.viewCount is int && data.viewCount >= 0
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCounterIncrement(inc, ext) {
      return (
        (
          inc.diff(ext).affectedKeys().hasOnly(['downloadCount', 'updatedAt'])
          && inc.downloadCount == ext.downloadCount + 1
          && inc.updatedAt == request.time
        ) || (
          inc.diff(ext).affectedKeys().hasOnly(['viewCount', 'updatedAt'])
          && inc.viewCount == ext.viewCount + 1
          && inc.updatedAt == request.time
        )
      );
    }

    function isValidWebsiteCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'description', 'iconName', 'displayOrder', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'iconName', 'displayOrder', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.description is string && data.description.size() <= 240
        && data.iconName is string && data.iconName.size() <= 40
        && data.displayOrder is int && data.displayOrder >= 0
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebsiteBanner(data) {
      return data.keys().hasAll(['id', 'title', 'subtitle', 'imageUrl', 'ctaLabel', 'targetAppId', 'targetRoute', 'displayOrder', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'subtitle', 'imageUrl', 'ctaLabel', 'targetAppId', 'targetRoute', 'displayOrder', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.subtitle is string && data.subtitle.size() <= 240
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000
        && data.ctaLabel is string && data.ctaLabel.size() >= 1 && data.ctaLabel.size() <= 40
        && data.targetAppId is string && data.targetAppId.size() <= 128
        && data.targetRoute is string && data.targetRoute.size() <= 160
        && data.displayOrder is int && data.displayOrder >= 0
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebsiteUser(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'savedAppIds', 'favoriteAppIds',
          'browsingHistory', 'searchHistory', 'notificationsEnabled', 'compactMode',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'savedAppIds', 'favoriteAppIds',
          'browsingHistory', 'searchHistory', 'notificationsEnabled', 'compactMode',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() <= 100
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.savedAppIds is list && data.savedAppIds.size() <= 100
        && (data.savedAppIds.size() == 0 || (data.savedAppIds[0] is string && data.savedAppIds[0].size() <= 128))
        && data.favoriteAppIds is list && data.favoriteAppIds.size() <= 100
        && (data.favoriteAppIds.size() == 0 || (data.favoriteAppIds[0] is string && data.favoriteAppIds[0].size() <= 128))
        && data.browsingHistory is list && data.browsingHistory.size() <= 50
        && (data.browsingHistory.size() == 0 || (data.browsingHistory[0] is string && data.browsingHistory[0].size() <= 128))
        && data.searchHistory is list && data.searchHistory.size() <= 30
        && (data.searchHistory.size() == 0 || (data.searchHistory[0] is string && data.searchHistory[0].size() <= 80))
        && data.notificationsEnabled is bool
        && data.compactMode is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebsiteAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'addedBy', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 1 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() <= 100
        && data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidWebsiteSettings(data) {
      return data.keys().hasAll([
          'storeProDownloadUrl', 'websiteName', 'websiteLogoUrl', 'websiteDescription',
          'themeAccent', 'contactEmail', 'supportUrl', 'twitterUrl', 'telegramUrl',
          'githubUrl', 'seoTitle', 'seoDescription', 'seoKeywords',
          'latestStoreProVersion', 'latestStoreProVersionName', 'latestReleaseNotes',
          'latestReleaseDate', 'updateHistory', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeProDownloadUrl', 'websiteName', 'websiteLogoUrl', 'websiteDescription',
          'themeAccent', 'contactEmail', 'supportUrl', 'twitterUrl', 'telegramUrl',
          'githubUrl', 'seoTitle', 'seoDescription', 'seoKeywords',
          'latestStoreProVersion', 'latestStoreProVersionName', 'latestReleaseNotes',
          'latestReleaseDate', 'updateHistory', 'updatedAt'
        ])
        && data.storeProDownloadUrl is string && data.storeProDownloadUrl.size() >= 8 && data.storeProDownloadUrl.size() <= 500 && data.storeProDownloadUrl.matches('^https://.*')
        && data.websiteName is string && data.websiteName.size() >= 1 && data.websiteName.size() <= 80
        && data.websiteLogoUrl is string && data.websiteLogoUrl.size() <= 350000
        && data.websiteDescription is string && data.websiteDescription.size() <= 300
        && data.themeAccent is string && data.themeAccent.size() <= 30
        && data.contactEmail is string && data.contactEmail.size() <= 160
        && data.supportUrl is string && data.supportUrl.size() <= 300
        && data.twitterUrl is string && data.twitterUrl.size() <= 300
        && data.telegramUrl is string && data.telegramUrl.size() <= 300
        && data.githubUrl is string && data.githubUrl.size() <= 300
        && data.seoTitle is string && data.seoTitle.size() <= 120
        && data.seoDescription is string && data.seoDescription.size() <= 240
        && data.seoKeywords is string && data.seoKeywords.size() <= 300
        && data.latestStoreProVersion is string && data.latestStoreProVersion.size() <= 40
        && data.latestStoreProVersionName is string && data.latestStoreProVersionName.size() <= 80
        && data.latestReleaseNotes is string && data.latestReleaseNotes.size() <= 3000
        && data.latestReleaseDate is string && data.latestReleaseDate.size() <= 30
        && data.updateHistory is list && data.updateHistory.size() <= 25
        && (data.updateHistory.size() == 0 || (data.updateHistory[0] is string && data.updateHistory[0].size() <= 400))
        && data.updatedAt is timestamp;
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll(['eventType', 'appId', 'appName', 'category', 'userId', 'dateKey', 'createdAt'])
        && data.keys().hasOnly(['eventType', 'appId', 'appName', 'category', 'userId', 'dateKey', 'createdAt'])
        && data.eventType in ['app_view', 'install_click', 'storepro_redirect']
        && data.appId is string && data.appId.size() >= 1 && data.appId.size() <= 128
        && data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 120
        && data.category is string && data.category.size() <= 60
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt == request.time;
    }

    // ---------------------------------------------------------
    // Collection Rules
    // ---------------------------------------------------------
    match /website_apps/{appId} {
      allow get: if isValidId(appId) && (existing().status == 'published' || isAdmin());
      allow list: if existing().status == 'published'
        || isBootstrappedAdmin()
        || (isVerifiedUser() && existing().createdBy == request.auth.uid);

      allow create: if isValidId(appId)
        && isAdmin()
        && isValidWebsiteApp(incoming())
        && incoming().id == appId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(appId)
        && isValidWebsiteApp(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (isVerifiedUser() && existing().status == 'published' && isValidCounterIncrement(incoming(), existing()))
        );

      allow delete: if isValidId(appId) && isAdmin();
    }

    match /website_categories/{categoryId} {
      allow get: if isValidId(categoryId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedAdmin();

      allow create: if isValidId(categoryId)
        && isAdmin()
        && isValidWebsiteCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(categoryId)
        && isAdmin()
        && isValidWebsiteCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /website_banners/{bannerId} {
      allow get: if isValidId(bannerId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedAdmin();

      allow create: if isValidId(bannerId)
        && isAdmin()
        && isValidWebsiteBanner(incoming())
        && incoming().id == bannerId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(bannerId)
        && isAdmin()
        && isValidWebsiteBanner(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(bannerId) && isAdmin();
    }

    match /website_users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidWebsiteUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidWebsiteUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'email', 'displayName', 'photoURL', 'savedAppIds', 'favoriteAppIds',
              'browsingHistory', 'searchHistory', 'notificationsEnabled', 'compactMode', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /website_admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(adminUid)
        && isAdmin()
        && isValidWebsiteAdmin(incoming())
        && incoming().uid == adminUid
        && incoming().addedBy == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isValidId(adminUid)
        && isAdmin()
        && isValidWebsiteAdmin(incoming())
        && incoming().uid == existing().uid
        && incoming().addedBy == existing().addedBy
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(adminUid) && isAdmin();
    }

    match /website_settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'global' || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create, update: if isValidId(settingId)
        && settingId == 'global'
        && isAdmin()
        && isValidWebsiteSettings(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    match /website_analytics/{eventId} {
      allow get: if isValidId(eventId) && isAdmin();
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(eventId)
        && isVerifiedUser()
        && isValidAnalyticsEvent(incoming());

      allow update, delete: if false;
    }
  }
}
